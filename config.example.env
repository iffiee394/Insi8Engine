GROQ_API_KEY=
YOUTUBE_API_KEY=
PLAYLIST_ID=
PODCASTS_PLAYLIST_ID=
POLL_INTERVAL_MINUTES=15
GROQ_CHAT_MODEL=openai/gpt-oss-20b
# Groq models: https://console.groq.com/docs/models
# llama-3.3-70b-versatile shut down 16 Aug 2026. Alternative: openai/gpt-oss-120b

# ── LLM: Gemini first (free daily credits), Anthropic fallback (paid) ──
LLM_PRIMARY=gemini
FALLBACK_TO_ANTHROPIC=true

# Gemini — primary extraction (aistudio.google.com → Get API Key)
GEMINI_API_KEY=AI...
GEMINI_CHAT_MODEL=gemini-2.5-flash
GEMINI_FALLBACK_MODELS=gemini-2.0-flash,gemini-2.5-flash-lite

# Anthropic — fallback when Gemini quota/errors (console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-...
DEEP_MODEL=claude-haiku-4-5-20251001
DEEP_MAX_OUTPUT_TOKENS=16384

# Overnight batch: Anthropic Message Batch (~50% off). Set false to use Gemini credits instead.
BATCH_USE_ANTHROPIC=true

# Tavily — web research (optional)
TAVILY_API_KEY=tvly-...
# Advanced Tavily searches ≈ 2 credits each (adjust for your plan)
TAVILY_CREDITS_PER_SEARCH=2
MAX_RESEARCH_TARGETS=6
# ── Paths (optional overrides) ──
# DATA_DIR=./data
# LOG_PATH=./poll_worker.log

# ── Embedding (semantic search) ──
# https://ai.google.dev/gemini-api/docs/embeddings
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_OUTPUT_DIM=768
