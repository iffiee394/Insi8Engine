# The engine reads the PARENT project's .env first (D:\projS\CursorP1\.env),
# so you probably do not need this file at all. It documents what is used.

# --- already present in your project .env ---
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-2.5-flash
GEMINI_FALLBACK_MODELS=gemini-2.5-flash-lite
ANTHROPIC_API_KEY=
DEEP_MODEL=claude-sonnet-5
GROQ_API_KEY=
TAVILY_API_KEY=
LLM_PRIMARY=gemini

# --- engine-specific, all optional ---
ENGINE_CLIENT=northfield-dental      # which client profile to load by default
GROQ_WHISPER_MODEL=whisper-large-v3-turbo

# Part D, Instagram mining at volume (~$1.00 per 1,000 results)
APIFY_TOKEN=
APIFY_IG_ACTOR=apify~instagram-reel-scraper

# Publishing. Without this the engine writes a free upload bundle instead.
# Even with it set, the engine only ever SCHEDULES - it never fires an
# immediate post, and it refuses without a recorded clinical approval.
BLOTATO_API_KEY=
