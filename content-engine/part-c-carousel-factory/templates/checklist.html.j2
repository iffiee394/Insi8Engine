{% extends "_base.html.j2" %}
{# CHECKLIST — oversized numerals against a light ground, with a progress rail
   down the left edge. Built for "signs of", "questions to ask", "steps to". The
   rail gives the reader a visible reason to reach the end, which is what feed
   completion rewards. #}

{% block styles %}
  .canvas{padding:84px 76px 72px 108px}
  .rail{
    position:absolute;left:56px;top:110px;bottom:110px;width:6px;
    background:var(--rule);border-radius:3px;
  }
  .rail .fill{
    position:absolute;top:0;left:0;width:6px;border-radius:3px;
    background:var(--accent);
  }
  .num{
    font-family:var(--display);font-weight:800;font-size:158px;line-height:.8;
    color:var(--accent);letter-spacing:-.06em;
  }
  .canvas.body .headline{font-size:66px;line-height:1.06}
  .canvas.hook{background:var(--accent-wash)}
  .canvas.hook .headline{font-size:88px}
  .canvas.hook .num{font-size:200px;opacity:.24;color:var(--accent-deep)}
  .canvas.cta{background:var(--ink)}
  .canvas.cta .headline{color:#fff;font-size:72px}
  .canvas.cta .body-copy{color:var(--accent-wash)}
  .canvas.cta .kicker{color:var(--highlight)}
  .canvas.cta .ident,.canvas.cta .logo{color:var(--accent-wash);opacity:.85}
  .canvas.cta .counter{color:var(--accent-wash)}
  .ident-card{border-top:3px solid var(--highlight);padding-top:24px;
              display:flex;flex-direction:column;gap:10px}
{% endblock %}

{% block content %}
  {% if slide.role != 'cta' %}
    <div class="rail">
      <div class="fill" style="height:{{ ((index / total) * 100)|round(1) }}%"></div>
    </div>
  {% endif %}

  {% if slide.role == 'hook' %}
    <div class="top-band">
      <div class="kicker">{{ slide.kicker|default('Checklist') }}</div>
    </div>
    <div class="center" style="gap:34px">
      <h1 class="headline">{{ slide.headline }}</h1>
      <div class="num">{{ total - 2 }}</div>
      <p class="body-copy">{{ slide.body }}</p>
    </div>
    <div style="height:36px"></div>

  {% elif slide.role == 'cta' %}
    <div class="center" style="gap:28px">
      <div class="kicker">{{ slide.kicker|default('Save this') }}</div>
      <h2 class="headline">{{ slide.headline }}</h2>
      <p class="body-copy">{{ slide.body }}</p>
    </div>
    <div class="ident-card">
      <div class="logo">{{ brand.logo_text|default(client.name) }}</div>
      <div class="ident">{{ identification }}</div>
    </div>

  {% else %}
    <div class="top-band">
      <div class="num">{{ '%02d'|format(index - 1) }}</div>
      {% if slide.kicker %}<div class="kicker">{{ slide.kicker }}</div>{% endif %}
    </div>
    <div class="center" style="gap:30px">
      <h2 class="headline">{{ slide.headline }}</h2>
      <p class="body-copy">{{ slide.body }}</p>
    </div>
    {% if slide.claims %}
      <div class="cite">
        {% for c in slide.claims %}{% if c.source_url %}Source: {{ c.source_url }}{% if not loop.last %}<br>{% endif %}{% endif %}{% endfor %}
      </div>
    {% endif %}
    <div style="height:40px"></div>
  {% endif %}
{% endblock %}
